# ── LLM Provider (for the Aura agent) ───────────────────────────────
# OpenRouter keys look like "sk-or-v1-...". Model names use "org/model"
# format, e.g. anthropic/claude-sonnet-4, openai/gpt-5.2, google/gemini-2.5-pro.
# See https://openrouter.ai/models for the full list.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4

# ── Mezmo (live log search via the mezmo-proxy service) ─────────────
# Goes to the mezmo-proxy container ONLY, never to the aura container --
# the proxy holds this credential so its production-only scope and
# read-only tool allowlist can't be bypassed. See services/mezmo-proxy.
MEZMO_API_KEY=

# ── Freshdesk (bug ticket search) ───────────────────────────────────
# Either the bare subdomain (e.g. "acme" for acme.freshdesk.com) or a
# full custom portal domain (e.g. "support.acme.com") if you've mapped
# one via Freshdesk's custom domain feature. Don't include https:// or
# a trailing path.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# ── Robot Operations Center dashboard (fleet presence) ──────────────
# Where fleet-status-mcp reads "is this robot online right now" from.
# Optional: leave unset to accept the default below, which only resolves
# if this host is on the Tailnet with MagicDNS. The container starts
# either way -- the fleet_* tools just return an error if it's
# unreachable, and the agent loses its ability to tell "no logs because
# nothing broke" apart from "no logs because the robot was off".
#
# IMPORTANT if you run this stack ON THE SAME MACHINE as the dashboard:
# do NOT use that machine's hostname here. Ubuntu maps a host's own name
# to 127.0.1.1 in /etc/hosts, so inside a container the name means the
# CONTAINER, where nothing is listening -- you get "connection refused"
# while curl on the host returns 200, which looks like a dead dashboard
# and is not. Use the host's routable address instead:
#     tailscale ip -4          # or its LAN IP
#     ROC_DASHBOARD_URL=http://100.x.y.z:3001
# The dashboard must also listen on 0.0.0.0, not just 127.0.0.1 --
# check with `ss -ltnp | grep 3001`. fleet-status-mcp detects this case
# and says so in its error.
#ROC_DASHBOARD_URL=http://roc-ubu:3001
