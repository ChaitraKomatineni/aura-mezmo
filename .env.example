# ── LLM Provider (for the Aura agent) ───────────────────────────────
# OpenRouter keys look like "sk-or-v1-...". Model names use "org/model"
# format, e.g. anthropic/claude-sonnet-4, openai/gpt-5.2, google/gemini-2.5-pro.
# See https://openrouter.ai/models for the full list.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4

# ── Mezmo (live log search/export via hosted MCP) ───────────────────
MEZMO_API_KEY=

# ── Freshdesk (bug ticket search) ───────────────────────────────────
# Either the bare subdomain (e.g. "acme" for acme.freshdesk.com) or a
# full custom portal domain (e.g. "support.acme.com") if you've mapped
# one via Freshdesk's custom domain feature. Don't include https:// or
# a trailing path.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# ── Domo (embedded dashboard, display-only) ─────────────────────────
# The URL from a Domo Card/Page's Share > Embed option.
DOMO_EMBED_URL=
