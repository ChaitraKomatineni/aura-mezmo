.env
__pycache__/
*.pyc

# Real account data from experiments/mezmo-mcp-validate -- never commit
# actual log field names/content pulled from a live Mezmo account.
experiments/mezmo-mcp-validate/out/
mezmo_raw_output_*.json
mezmo_report_*.html

# Same rule for the behaviour probe -- its records carry real host names,
# field names and line counts from the live account.
experiments/mcp-tool-behavior/out/
tool_behavior_*.json
# Generated by make_report.py from those records -- regenerate rather than
# commit; it likewise carries real host names and line counts.
experiments/mcp-tool-behavior/TOOL_REPORT.md

# Local reference material (vendor PDFs, cheat sheets) -- not part of the
# deployable stack and not reviewed for customer data.
Resources/

# Bug reports from the UI. Same rule as above, and stricter: a report
# stores the tool results from the turn it describes, which are real
# production log lines.
reports/
